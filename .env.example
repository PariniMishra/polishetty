# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# API key from https://resend.com/api-keys
RESEND_API_KEY= 

# Inbox that receives enquiries from the contact form
CONTACT_EMAIL=

# Sender shown on enquiry emails. Must use a domain verified in Resend.
# Resend's test sender (onboarding@resend.dev) only delivers to your own Resend account email.
FROM_EMAIL="Polishetty Foundation <onboarding@resend.dev>"

# Public URL of the site, e.g. https://polishettyfoundation.org (used for SEO metadata)
NEXT_PUBLIC_SITE_URL= 
